            8'h79: begin  // vector IEEE minNum/maxNum — the signed-int compare tree is NEVER reused for FP; sub-op encoding v1.8.0b
                // v1.8.0a COMMIT 2 stub: decode-legal, PE_Core raises lower_required
                // (capability absence, not malformation). Mode-byte legality per the
                // normative spec §23.6a table — restrictive-first, later loosening
                // only.
                req_port         = 1'b1;
                forbid_subscript = 1'b1;
                forbid_mem       = 1'b1;
            end
            8'h7C: begin  // STORE_QUANT — scalar int-dest requant: out=clamp_dtype(RNE(x>>s)), s=imm16[5:0] (absent=0, pure saturating clamp), x=signed int64 payload; dtype 0x0->[-8,7], 0x1->[-128,127]; 0x2/0x3 (f16/bf16) lower_required until v1.8.0d; emits sext64; L-PE hosted (no multipliers)
                // v1.8.0b IMPLEMENTED (scalar form). Monotonic loosenings: mem
                // required->optional (present = offset IGNORED in 0b, RESERVED for
                // the v1.8.0d memory-destination store form — asm warns), imm16
                // forbidden->optional. imm16[15:6] reserved-zero else
                // lower_required. Never asserts memory_req in 0b.
                req_port         = 1'b1;
                forbid_subscript = 1'b1;
                forbid_opref     = 1'b1;
            end
            8'h7D: begin  // accumulator spill/fill quarter-ops — frag FSM untouched; sub-op encoding v1.8.0b
                // v1.8.0a COMMIT 2 stub: decode-legal, PE_Core raises lower_required
                // (capability absence, not malformation). Mode-byte legality per the
                // normative spec §23.6a table — restrictive-first, later loosening
                // only. v1.8.0b: stays stub — the "int32 spill loosening if needed"
                // is affirmatively NOT needed (no accumulator exists); dtype row
                // untouched.
                req_port         = 1'b1;
                req_mem          = 1'b1;
                forbid_subscript = 1'b1;
                forbid_imm_any   = 1'b1;
                forbid_opref     = 1'b1;
            end
            8'h7E: begin  // FP_ACC_ZERO / FP_STATUS (sticky IEEE flags, atomic read-and-clear) — sub-op encoding v1.8.0b
                // v1.8.0a COMMIT 2 stub: decode-legal, PE_Core raises lower_required
                // (capability absence, not malformation). Mode-byte legality per the
                // normative spec §23.6a table — restrictive-first, later loosening
                // only. v1.8.0b: stays stub — nothing to zero (no accumulator
                // exists); ZERO/STATUS sub-op encoding decision defers WITH the op
                // to v1.8.0c (do not burn the encoding space early).
                req_port         = 1'b1;
                forbid_subscript = 1'b1;
                forbid_mem       = 1'b1;
                forbid_imm_any   = 1'b1;
                forbid_opref     = 1'b1;
            end
            default: begin
                forbid_subscript = 1'b1; forbid_mem = 1'b1;
                forbid_imm_any   = 1'b1; forbid_opref = 1'b1;
            end
