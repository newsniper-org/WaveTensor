{
  "name": "WaveTensor 검증 환경 (formal + sim)",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "ALA_SNAPSHOT": "2026/08/12",
      // TLA+ / TLC — ⚠️ 이 넷은 **불변 아티팩트 핀이 아니다.** `v1.8.0` 은
      // 롤링 pre-release 라 master 커밋마다 같은 URL 에 새 빌드가 덮인다
      // (상류가 설계한 동작). 불변 좌표(Maven 스냅샷 타임스탬프 빌드)로의
      // 전환은 2026-08-29 에 시도했고 **358 run 배터리 실측으로 기각**했다 —
      // 그 아티팩트는 자립 실행 배포본이 아니다(javax.mail·gson 결손).
      // 전문은 Dockerfile §3. 여기의 넷은 Dockerfile ARG 와 반드시 같아야
      // 하고 scripts/lint_toolchain_pins.py 가 그것을 대조한다.
      "TLA_VERSION": "1.8.0",
      "TLA_BLAKE2B512": "a2ccfb8c78b9704c68c9b29534b11254c6b30729d48182b795420f1a1294252f1d7329c3d6f4fe7151705bbd6883210e4cb2055ab918871c3709c33a0bf379f9",
      "TLA_TLC_BUILD": "2026.09.10.191157",
      "TLA_TLC_REV": "c3af5e2",
      "COCOTB_VERSION": "2.0.1",
      // `COCOTB_PYTHON` 은 2026-08-30 까지 **Dockerfile 에만 있었다** — 즉 한쪽
      // 선언이고 대조 대상이 아니었다. 값이 아니라 *등재*를 고치는 것이다:
      // 여기 없으면 VS Code 재빌드가 Dockerfile 기본값으로 굽고, 누군가
      // 여기에만 다른 값을 적으면 아무도 알아채지 못한다.
      // ⚠️ 이것은 **마이너 좌표**라 uv 가 빌드 시점의 최신 패치로 해석한다
      // (실측 2026-08-29: `3.13.15`). 전문은 Dockerfile §4.
      "COCOTB_PYTHON": "3.13",
      "WITH_SBY": "1",
      // `SBY_COMMIT` 도 같은 결손이었다 — `WITH_SBY` 는 여기 있는데 그것이
      // 켜는 층의 **핀**은 없었다. 켜고 끄는 것만 양쪽에 있고 무엇을 켜는지는
      // 한쪽에만 있던 셈이다.
      "SBY_COMMIT": "f57802a16613f013e84e024df50fc3f0ea74f88b",
      // btormc(cover 모드 비트 수준 모델 체커) — Boolector 3.2.4 소스 빌드.
      // 세 커밋은 상류 3.2.4 의 contrib/setup-*.sh 가 선언한 값이고
      // Dockerfile 의 grep 대조가 그 일치를 빌드마다 다시 잰다.
      // scripts/lint_toolchain_pins.py 가 여기 ↔ Dockerfile ARG 를 대조한다.
      "WITH_BTORMC": "1",
      "BOOLECTOR_VERSION": "3.2.4",
      "BOOLECTOR_COMMIT": "393cdfba3735d334bb4e6525500b8a0280dd41e6",
      "BTOR2TOOLS_COMMIT": "037f1fa88fb439dca6f648ad48a3463256d69d8b",
      "LINGELING_COMMIT": "7d5db72420b95ab356c98ca7f7a4681ed2c59c70",
      // SpinalHDL 툴체인 고정 — 이 넷은 rtl/spinal/ 의 빌드 파일과
      // **반드시 일치**해야 한다. scripts/lint_toolchain_pins.py 가 대조한다.
      "SBT_VERSION": "1.12.15",
      "SCALA_VERSION": "2.13.12",
      "SPINAL_VERSION": "1.14.2",
      "UID": "${localEnv:UID:1000}",
      "GID": "${localEnv:GID:1000}"
    }
  },

  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

  "remoteUser": "wt",
  // VS Code 는 이 값으로 컨테이너 사용자 UID 를 호스트에 맞춘다.
  // ⚠️ rootless podman 을 **수동으로** 쓸 때는 이것이 적용되지 않는다 —
  //    `--userns=keep-id` 가 필요하다. 없으면 저장소가 컨테이너 안에서
  //    uid 0 소유로 보여 TLC 가 `states/` 를 못 만들고 형식 게이트가 죽는다
  //    (실측: util.Assert$TLCRuntimeException "could not make a directory").
  //    README 의 수동 실행 예를 그대로 쓸 것.
  "updateRemoteUserUID": true,

  "containerEnv": {
    // cocotb 결과 파일을 tracked results.xml 위에 쓰지 않는다.
    // 호스트에서 반복해서 밟았던 함정을 환경 기본값으로 막는다.
    "COCOTB_RESULTS_FILE": "/tmp/cocotb-results.xml"
  },

  "postCreateCommand": "~/wt-toolversions.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "mshr-h.veriloghdl",
        "ms-python.python",
        "alygin.vscode-tlaplus",
        "myriad-dreamin.tinymist",
        "scalameta.metals"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.insertSpaces": true
      }
    }
  },

  // ⛔ Vivado 는 이 컨테이너에 없다 (의도).
  //    합성 gate 는 호스트에서:
  //      make synth-sys-gate SYS_GATE=sys_top_core PART=xcu55c-fsvh2892-2L-e
  //      python3 synth/scripts/fp_op_gate_check.py
  //    컨테이너에서 도는 것: make lint / cocotb / proofs/tla/run.sh / golden
  "remoteEnv": {
    "WT_ENV": "devcontainer"
  }
}
