#
# PROVES: Payload.key_is_tag — 활성 문맥 쌍 키 투영 상이 불변식 inv_tag_uniq_* + 조각/소거 CAM hit 쌍별 배타 inv_hit_excl_*·inv_abhit_excl_*: 키당 활성 문맥 <= 1, hit 는 one-hot
# PROVES: Payload.key_drops_side — p_key_hit_*·p_key_abhit_*·p_key_clash(세 매칭 == 활성 ∧ 필드별 키 등식 wave·에포크·LNID·정밀도·차원 — poison·trace 를 넣는 기계도 키 필드를 빠뜨린 기계도 반례) · 증인 W22(조각 절반)·W23(소거 절반 — 0 을 싣는 소거가 trace·poison 문맥을 지운다)·W24(개시 절반)
# PROVES: Payload.no_restart — p_no_restart_grant(재개시 granted 억제) + p_no_restart_evt(거절 사건 정의) + t_no_restart_loud(다음 사이클 fault 관측)
# PROVES: Payload.no_dup_seq — p_no_dup_accept: 수락은 seen 에 없는 순번뿐 (재기입 부재의 원천)
# PROVES: Payload.cap_check — inv_total_bounds_*(래치 총개수 1..16) + p_cap_window(발화 시 순번 1..선언 총개수 <= slotCap) + p_cap_off(off = 순번-1): 기입 면에 구간 밖 좌표 부재
# PROVES: Payload.capability_not_fault — p_capa_excl(조각 축 set 동시 부재) + t_fault_next_eq/t_capa_next_eq(sticky set 원천 전수 등식 — 능력 부재는 fault 를, malformation 은 capAbsent 를 세울 수 없다)
# PROVES: Payload.last_judges — p_last_judges_def(종료 판정 문면 등식) + t_last_judges_loud(불완전 종료 → fault) + t_last_src_*(last 래치 상승 원천 = 수락 조각의 표시뿐) · 증인 W19(불완전 종료 → fault 첫 상승)·W20(last 상승)·W21(완전 종료 갈래 — 인도 도달)
# PROVES: Payload.reset_on_deliver — t_deliver_frees_*(인도 완결 즉시 해방) + inv_free_clean_*(비활성 문맥 회계 공 — 해방 = 회계 소거 동시) · 증인 W21(인도 완결 실재 — 종전 「미결 보고」, 2026-09-24 이월 B 로 닫음)
# PROVES: Payload.abort_erases — t_abort_frees_*(소거 발화 즉시 해방) + inv_free_clean_*(태그만 해방하고 회계를 남기는 경로 부재)
# PROVES: Payload.abort_clears_window — p_abort_clears_slots(구간 무효화 명령 == 소거 발화, 같은 게이트 — 「회계는 비웠는데 구간은 안 비웠다」 표현 불가) + p_clr_base_*(좌표 = 소거 대상의 결속, 결속 폐기 *전*) + p_clr_needs_hit(허공을 비우는 beat 부재)
# PROVES: Payload.abort_leaves_trace — p_ab_fire_def + t_ab_cnt_inc/sat/hold: 소거 발화 = 카운트 증가 동시 (포화 0xff), 없는 태그 무시는 카운트 부동
# PROVES: Payload.abort_not_fault — p_ab_not_fault_src/p_ab_not_capa_src(set 사건 원천에 소거 항 부재) + t_fault_next_eq(sticky set 원천 전수 등식)
# PROVES: Payload.write_atomic — p_wr_atomic_face(기입 발화 == 접수, 같은 사이클) + t_wr_atomic_*(접수 사이클에 seen·total 회계 원자 진행)
# PROVES: Payload.capability_check — p_capa_def(능력 판정 == 독립 비트분해 참조 total>16 — DUT 비교기 재인용 아님, 조용한 절단 검출) + p_capa_excl_all(능력 밖 조각은 나머지 판정·기입·거절사건 전부에 불참) + t_capa_no_acct_*(회계 4문맥 부동) + t_capa_absent_loud(능력 부재의 관측면 도달)
# PROVES: Payload.base_from_tag — p_wr_base_*(기입 착지 = 적중 문맥의 결속) + t_base_stable_*(개방 착지 없는 사이클에 결속 부동 — 조각 경로에 base 기입 부재) + t_base_src_*(그 유일 기입의 값 = 개시가 준 목적 LBID)
# PROVES: Payload.loud_reject — t_loud_frag(조각이 왔는데 수락되지 않으면 다음 사이클에 fault ∨ capAbsent — 전건이 사유 신호의 재인용이 아니라 ¬accept 하나라 「조용한 드롭 경로」가 하나라도 생기면 반례) + t_loud_open(재시작 충돌 → fault, 풀 고갈은 모델 밖이라 전건에서 배제) + t_fault_next_eq/t_capa_next_eq(명시 해제 없이 내려가지 않는다)
#
# ── 이 태스크가 *재지 않는* 것 — 좁힌 문면 (통합자 보고 대상) ──────────────
#
# Payload.base_from_tag 의 모델 문면은 Payload.tla:482
#   `(~Free(c)) \/ (~On("base_from_tag")) \/ (b = (t-1)*SlotCap)`
# 즉 **구간 시작이 태그의 함수**여야 한다는 것이다. 그 알맹이는 이 모듈이
# 재지 못한다 — io.open.base 는 in port(Reassembly.scala:165)이고 태그 →
# 목적 LBID 사상은 디코드(ACCTGT) 소관이다. 위 PROVES 가 잰 것은 그 위임
# *뒤쪽* 절반뿐이다: 「받은 결속이 개방 시 1회만 확정되고, 그 뒤 조각 경로가
# 건드리지 않으며, 기입 착지가 그 결속으로만 계산된다」. GUARD-MAP 문면
# (Reassembly.scala:40) 자신이 그 위임을 적고 있으므로 CHECK 로 남는 것은
# 정당하나, **좁은 증명이 넓은 모델 가드를 대신한다**는 사실을 여기 남긴다.
# 남은 절반의 자리: 태그→LBID 사상의 소유자(디코드 ACCTGT 경로).
#
# Payload.loud_reject 의 개방 축에는 모델 밖 갈래가 하나 있다 — 풀 고갈
# (freeAny=0) 개방 거절은 fault 가 아니라 granted=False 의 명시적 처분이다
# (Reassembly.scala 파일 머리 「어긋난 자리」). t_loud_open 은 그것을 전건에서
# 명시적으로 뺀다. 빼지 않으면 *거짓 반례*가 나므로 그 배제가 정확성의
# 조건이고, 배제가 장식이 아니라는 것은 증인 W17 이 보인다 (그 갈래가 실제로
# 도달 가능하다).
#
# 대상: rtl/generated/Reassembly.sv (커밋본 — 재생성 금지, nCtxs=4·slotCap=16).
# 처분은 전부 1사이클(파이프 깊이 1 — 판정 조합 + 회계 래치 1단) — bmc 깊이
# 20 은 그 2배를 훨씬 넘는 여유이며 개방→조각열→종료→해방 전 과정을 덮는다.
# prove 는 k-귀납(깊이 8)이 선다 — 그것이 정답 (불변식 inv_* 가 귀납 가설을
# 닫는 보조 불변식 역할까지 겸한다).

# ── 역-변이 표 — key_drops_side (태그 코덱 전파 파도, 2026-09-26 · 비상주: 생성물 사본에 한 줄씩, bmc = abc bmc3) ──
#   RM1  fr_hit_0 에 trace 등식 연언 (오늘의 번들 통비교의 조각 절반)  ⇒ p_key_hit_0
#   RM2  ab_hit_0 에 poison 등식 연언 (소거 절반 — D2b 의 호스트 가시 귀결) ⇒ p_key_abhit_0
#   RM3  op_clash 문맥 0 항에 trace 등식 연언 (개시 절반)            ⇒ p_key_clash
#   RM4  fr_hit_0 의 양변에서 에포크를 뺌 (키 필드 누락 방향)         ⇒ p_key_hit_0
#   X3   ab_hit_1 에 trace 등식 연언 (문맥 ≠ 0 · 소거 절반)            ⇒ p_key_abhit_1
#   X4   fr_hit_1 에 poison 등식 연언 (문맥 ≠ 0 · 조각 절반)           ⇒ p_key_hit_1
#   X5   op_clash 문맥 1 항에 poison 등식 연언 (문맥 ≠ 0 · 개시 절반)   ⇒ p_key_clash
#   일곱 다 사살 (rc=2) — **게이트 자신의 bmc 태스크(abc bmc3, 깊이 20)로**, 프레임 3 · 벽시계
#   1~2 초 (2026-09-27 재실측, 컨테이너). 종전 기록의 넷은 smtbmc z3 로 쟀는데, 같은 엔진에서
#   X3~X5 는 step 2 에 웨지해 240 초 타임아웃으로 끝났다(검토 실측) — 그래서 bmc 엔진을 바꿨다
#   (아래 [options] 주석). 등식이라 두 방향(비트를 더함 · 필드를 뺌)을 다 잰다.

[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 20
prove: mode prove
prove: depth 8
# cover 깊이 16: 2차 파도의 가장 깊은 증인은 W17(풀 고갈 — 상이 태그 개방
# 4회로 문맥 4개를 채운 뒤 다섯째 개방)이고 reset 후 6 사이클이면 닿는다.
# 그 2배 이상으로 여유를 둔다 (종전 W4 는 4~5 사이클).
#
# 이월 B(2026-09-24) 실측 — last_judges · reset_on_deliver 증인 셋 신설 후,
# smtbmc z3 · depth 16 그대로 (cover 태스크 단독, 벽시계 1 초, 21/21 도달 ·
# 미도달 0). 깊이·엔진 둘 다 바꿀 이유가 없다 — 최심 증인은 여전히 W17 이다:
#   W19  불완전 종료 → fault 첫 상승   step 4  (개방 1 · 조각 last ∧ 미완 1)
#   W20  last 래치 상승               step 4  (같은 궤적의 래치면)
#   W21  인도 완결 (grant[0])          step 5  (개방 1 · 조각 total=1 last 1 ·
#                                              인도 ready 1 → 다음 사이클)
#   W17  풀 고갈 (종전 최심)           step 6
#   나머지 17 개                       step 3~5
cover: mode cover
cover: depth 16
multiclock off
# bmc 엔진 = abc bmc3 (+ aigsmt z3 궤적 재생) — 태그 코덱 전파 파도 검토 처방
# (2026-09-27). 종전 smtbmc z3 는 무변이 GREEN 에 8분 5초가 걸렸고, 문맥 ≠ 0
# 의 키 매칭 변이(X3 ab_hit_1 에 trace · X4 fr_hit_1 에 poison · X5 문맥 1
# op_clash 항에 poison)에서 「Checking assertions in step 2」에 웨지해 240초
# 타임아웃(rc=124)으로 끝났다 — 게이트가 회귀를 「안 끝남」으로 위장한다
# (solver_blindness_trap). 같은 변이를 abc bmc3 는 프레임 3 에서 초 미만에
# 잡는다. prove(k-귀납 smtbmc z3)는 무변이 50초라 그대로 두되, timeout 이
# 웨지를 「안 끝남」 대신 비-PASS 로 드러낸다.
bmc: aigsmt z3
timeout 900

[engines]
bmc: abc bmc3
prove: smtbmc z3
cover: smtbmc z3

[script]
# yosys 개방판(0.66 실측)은 SV bind 문을 조용히 무시한다 (인스턴스 미생성 —
# 가짜 대상 bind 도 무오류 통과). 아래 exec 네 줄이 하네스의 bind 문을 그
# 의미 그대로 — 대상 모듈 본문 안 인스턴스로 — 텍스트 전개한다. 전개하는
# 것은 워크디렉터리 사본이다 (저장소 사본은 불변, bind 지원 도구에선 하네스
# 파일이 그대로 선다). sed 프로그램은 yosys 스크립트의 ';' 분리·인용 전달
# 함정을 피해 무공백·무'$' 형태로 쓴다.
exec -- sh -c "sed /^bind/Q Reassembly_props.sv > props_only.sv"
exec -- sh -c "sed -i /^endmodule/d Reassembly.sv"
exec -- sh -c "sed -n /^bind/,+999p Reassembly_props.sv | sed s/^bind.Reassembly.// >> Reassembly.sv"
exec -- sh -c "echo endmodule >> Reassembly.sv"
# 증인(cover)은 cover 태스크에서만 컴파일한다 — bmc/prove 모델은 종전과
# 한 비트도 다르지 않게 유지한다 (XlateStore 선례).
bmc:   read_verilog -sv -formal props_only.sv
prove: read_verilog -sv -formal props_only.sv
cover: read_verilog -sv -formal -DREASM_COVER props_only.sv
read_verilog -sv -formal Reassembly.sv
prep -top Reassembly
# fullMask 조회 case 표를 proc_rom 이 $mem_v2 ROM 으로 승격시키는데, ROM
# 내용 init 은 초기 상태에만 걸려 k-귀납의 임의 시작 상태에선 *자유*가 된다
# (실측 — 귀납이 fullMask[8]=0x1040 인 가짜 세계에서 t_wr_atomic_3 반례를
# 만들었다). memory_map 이 ROM 을 상수 논리로 강하시켜 전 상태 구속을
# 복원한다 — 진짜 메모리는 이 설계에 없으므로 의미 변화 없음.
memory_map

# [files] 경로는 저장소 루트 기준이다 — sby 는 상대 경로를 sby 파일이
# 아니라 *호출 cwd* 기준으로 푼다 (스윕 실측: ../ 경로가 루트 호출에서 깨짐).
# make rtl-postformal · 스윕 · 수동 실행 전부 루트에서 호출하는 것이 규약이다.
[files]
rtl/generated/Reassembly.sv
rtl/sv/assert/Reassembly_props.sv
