#
# 착지판 하네스(6fb8160b8f866f34 — 오라클이 xstg 의 needReady · commit.valid · commit.frame ·
# badWrite 였다)의 X 표는 이 절로 대체했다. X1–X13 은 위에 같은 치환으로 다시 들어 있다 (X1=Y13 ·
# X2=Y11 · X3=Y10 · X4=Y15 · X5=Y21 · X6=Y06 · X7=Y05 · X8=Y12 · X9=Y28 · X10=Y25 · X11=Y29 ·
# X12=Y03 · X13=Y22). 착지판이 「탈출 — 스테이징 의미는 이 태스크가 재지 않는다」로 적은 셋에
# 셋을 더한 여섯(Y03 · Y05 · Y06 · Y07 · Y08 · Y33)을 착지판 하네스 + 착지판 [script] 로 다시 돌려
# 여섯 다 PASS 를 재현했다 (B0 PASS) — 하네스가 문의 출력을 오라클로 삼으면 문의 결함은 문의
# 출력과 핀이 함께 틀려 등식이 선다. 이 판에서는 여섯 다 a_xhi_iff 에서 죽는다.
# 착지 세션의 구동기가 XlateStaging/props.sby bmc 에 X2 · X5 · X6 · X7 · X8 · X12 · X13 을,
# xlatestore.sby prove 에 저장 절반 셋(커밋의 validBits <= commitLine_v → 1'b1 · storeHit 의 가림
# 탈락 · fillHit 의 v 탈락)을 걸었고 전부 FAIL · 각 B0 PASS 였다 (착지판 실측 — 그 두 .sby 머리가
# 표를 되풀이하지 않는다 — 이 절 하나가 소유한다). 이 후-formal 재실측은 그 둘을 다시 돌리지 않았다.
# 저장 절반 셋은 전부 커밋 줄 mux 출력(commitLine_v · commitLine_idx)의 *하류*였다 — mux 자체는
# 한 번도 변이되지 않았고, 하네스(XlateStore_props.sv)의 validBits 커밋 전이 오라클이 바로 그 mux
# 출력이었다. 반증 검토(같은 날)가 넷째를 걸어 탈출을 실측했다:
#   XS1   case 2'b00 의 _zz_commitLine_v = fillSlot_0_v → fillSlot_1_v (다른 슬롯의 v)
#         착지판 하네스: bmc · prove · cover 12/12 전부 PASS (탈출 — 재현 실측)
# 수리: 하네스가 v · idx 를 커밋되는 슬롯의 몸체(f_slot[p] · f_slot[commitSel])에서 읽는다 —
# validBits 커밋 전이 · install_scoped 의 주소 · W3 · W4 · W11 의 가드. 수리판 실측(격리 사본 ·
# 컨테이너 · xlatestore.sby 무수정 bmc/prove/cover): 무변이 PASS ·
#   XS1   FAIL — validBits 커밋 전이 단언 (hi_v_carried 저장 절반)
#   XS2   case 2'b00 의 _zz_commitLine_idx = fillSlot_0_idx → fillSlot_1_idx (다른 슬롯의 idx)
#         FAIL — 같은 단언 (주소가 슬롯 몸체에서 오므로 install_scoped 의 제외 주소도 더는 따라
#         틀리지 않는다)
# 이 재실행도 상주하지 않는다 (역-변이 표 머리 (l)).
#
# ## 역-변이 표 — 파도 4 (D2 · AbortSurface 앵커 셋, 2026-09-26 재실측)
#
# 같은 방법 · 같은 비상주 처분 (구동기 /var/tmp/w1mut — 커밋하지 않았다). 입력 sha256 앞 16자:
#   rtl/generated/Wt64Top.sv          aa510b191e133445
#   rtl/sv/assert/Wt64Top_props.sv    3c991439e602b2ec
#   [script] = 이 파일의 [script] 그대로 (무결성 핀 여섯 포함 · assert 93)
# 결과: 무변이 B0 PASS(bmc · cover) · 사살 변이 6 전부 bmc FAIL. 파도 4 의 신설 라벨 a_arm_rej1 과
# surfMust 로 옮긴 TAG1 항(a_surf_fire), AbortSurface 앵커 셋(ro_rejected · reject_loud ·
# legal_first) 전부에 사살 변이가 있다. 증인 W28 은 D2 계열 변이 넷에서 미도달, W4 는 A05 에서
# 미도달(cover 태스크) — 증인이 수리판에서만 서는 궤적이라는 확인이다.
#
#   id    치환 (생성 SV)                                          가드(AbortSurface)  ⇒ 첫 적발 (bmc) · cover
#   A01   D2 이전 생성물 (HEAD d65b1c2 — TAG1 무검사)            poison_trace_zero · epoch_word_rsv_strict · legal_first ⇒ a_arm_rej1 a_surf_fire · W28 미도달
#   A02   AbortStaging tag1 마스크 0x0FFF → 0x03FF               poison_trace_zero      ⇒ a_arm_rej1 a_surf_fire · W28 미도달
#   A03   okTag1 = wr ∧ selTag1 (loud 이지만 무장)               legal_first         ⇒ a_arm_rej1 · W28 미도달
#   A04   badWrite 에서 TAG1 항 탈락 (조용한 거절)                reject_loud         ⇒ a_surf_fire · W28 미도달
#   A05   abortArea 거절선에서 RO 세 워드 쓰기 탈락               ro_rejected · reject_loud ⇒ a_surf_fire · W4 미도달
#   A06   abortArea_isTag0 에 wordOff == 6(0xF58) 합류            ro_rejected · legal_first ⇒ a_arm_src
#
# 검토 뒤 수리 (2026-09-26) — TAG1 스테이징 값의 에포크 경로. 착지판 a_tag1_lnid 는 LNID [15:0] 만
# 재서 아래 두 변이가 bmc 를 통과했다 (AbortStaging/props.sby 의 N1 · N2 와 같은 치환 — 유닛 쪽도
# 생존). a_tag1_val 로 이름을 바꾸고 {stg_io_tag_thread, stg_io_tag_lnid} == $past(D) 로 넓혔다 —
# 위 「라벨마다 사살 변이가 있다」 표의 S2 · S3 행이 부르는 a_tag1_lnid 가 이 단언이다 (옛 이름 · 그 사살은 넓힌 단언에서도
# 선다 — 넓힌 쪽이 옛 쪽을 함의한다). assert 93 · cover 36 불변. 입력: Wt64Top.sv aa510b191e133445 ·
# 수리 하네스 Wt64Top_props.sv 0a5815f68a87ab49 · 착지 하네스(인덱스판) 3c991439e602b2ec · 사본
# /var/tmp/w1fix-mut (지웠다). 컨테이너 셔김은 sby_sweep.sh 와 같다(yosys-abc 이름 잇기).
#   id    치환 (생성 SV · AbortStaging)                                  하네스   bmc (abc bmc3 d16)
#   B0a   무변이                                                        수리판   PASS
#   N1a   tag1 <= io_wdata → (io_wdata & 32'h0000ffff) (에포크 탈락)       착지판   PASS — 생존
#   N1a   〃                                                             수리판   FAIL a_tag1_val
#   N2a   무장 선 TAG1 재기입이 옛 에포크 [31:28] 을 남김                  착지판   PASS — 생존
#   N2a   〃                                                             수리판   FAIL a_tag1_val
#
# ## 축별 발화 우선 출처 표 — FAULT_STATUS
#
# 조립은 해제 라우팅(a_fclr_b*)과 읽기 배치(a_rd_fst)를 잰다. 「set 이 해제와 같은
# 사이클이어도 선다」는 유닛 쪽 단언이 든다 — 기준 형태는 전건이 set 사건뿐이고 clear 가
# 전건에 없는 것(또는 set 이 이기는 차기 상태 등식)이다. 각 줄은 착지 때 파일을 열어
# 형태를 다시 확인했다 (2026-09-26).
#
#   비트       원천                     유닛 쪽 발화 우선 (파일 · 형태 · 태스크 모드)
#   [0]        walk                     DecodeWalk_props.sv `if ($past(io_oValid && io_oMalformed)) assert (io_oFault)` · walk_decode bmc/prove
#   [1]        od                       OperandDecode_props.sv `if ($past(io_iValid && f_bodyMal)) assert (io_oFault)` · body_judge prove
#   [2]        rj                       RouteJudge_props.sv p_loud_fault (차기 상태 등식 — set 우선) · prove
#   [3]        reasm                    Reassembly_props.sv t_fault_next_eq (차기 상태 등식) · prove
#   [4]        hiu                      HiuMask_props.sv `if ($past(f_nonowned_hit)) assert (io_faultPerm)` · prove
#   [5]        cfgBlk dup               MmioConfig_props.sv p_dup_sticky (차기 상태 등식) · prove
#   [6]        cfgBlk bad · own bad ·   MmioConfig_props.sv p_bad_sticky · OwnershipTable_props.sv
#              cq bad · surf            `if ($past(f_statusWr)) assert (io_faultBadWrite)` · **cq: 없음** ·
#                                       surf: 이 태스크 a_surf_fire
#   [7]        own collide              OwnershipTable_props.sv `if ($past(f_collide)) assert (io_faultCollide)` · prove
#   [8]        merge                    FabricMerge_props.sv 의 Fabric.fault_raised 절 `if ($past(shoveAny)) assert (fault)` · contracts prove
#   [9]        shared_1                 SharedUnit_props.sv a_bp_fault_set · **다른 elaboration** (payload 161b 대 16b)
#   [10]       bank                     ResultBank_props.sv a_fault_loud · prove
#   [11] [12]  mask NoMask · NonceDup   **없음**
#   [13]       mask WrRekey             MaskEngine_props.sv a_final_overlap_loud · a_dirty_final_loud (완료 엣지 · 전건에 clear 없음) · engine prove
#   [14] [15]  fps Bp · BadProg         **없음** (StepSequencer 의 sby 태스크 0 건)
#   [16]       cq overflow              CompletionUnit_props.sv `if ($past(f_shove)) assert (io_faultOverflow)` · **bmc 뿐(유계)**
#   [17] [18]  —                        원천 없음 (상수 0 — a_rd_fst 가 읽기 0 을 잰다 · 미구현을 고정하는 단언)

[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 16
prove: mode prove
cover: mode cover
cover: depth 16
multiclock off
bmc: aigsmt z3
prove: aigsmt z3
timeout 600

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc z3

[script]
exec -- sh -c "sed /^bind/Q Wt64Top_props.sv > props_only.sv"
exec -- sh -c "sed -n s/^bind.Wt64Top.//p Wt64Top_props.sv > inj.sv"
exec -- sh -c "sed -n /^module.Wt64Top..$/,/^endmodule/p Wt64Top.sv | sed /^endmodule/d > top_dut.sv"
exec -- sh -c "cat inj.sv >> top_dut.sv && echo endmodule >> top_dut.sv"
exec -- sh -c "sed /^module.Wt64Top..$/,/^endmodule/d Wt64Top.sv > rest.sv"
bmc:   read_verilog -formal -sv props_only.sv
prove: read_verilog -formal -sv props_only.sv
cover: read_verilog -formal -sv -DWT64TOP_COVER props_only.sv
read_verilog -formal -sv top_dut.sv
read_verilog -formal -sv rest.sv
select -assert-count 14 Wt64Top/c:* Wt64Top/t:$* %d Wt64Top/t:CapStatusWord %d Wt64Top/t:AbortStaging %d Wt64Top/t:XlateStaging %d Wt64Top/t:Wt64Top_props %d
expose -evert -sep __ Wt64Top/c:* Wt64Top/t:$* %d Wt64Top/t:CapStatusWord %d Wt64Top/t:AbortStaging %d Wt64Top/t:XlateStaging %d Wt64Top/t:Wt64Top_props %d
hierarchy -top Wt64Top
select -assert-count 4 Wt64Top/c:* Wt64Top/t:$* %d
select -assert-count 253 Wt64Top/o:*__* Wt64Top/o:*__clk %d Wt64Top/o:*__reset %d
select -assert-count 209 Wt64Top/i:*__*
select -assert-count 91 Wt64Top/c:chk %ci1 Wt64Top/o:*__* %i
select -assert-count 60 Wt64Top/c:chk %ci1 Wt64Top/i:*__* %i
prep -top Wt64Top
select -assert-count 1 t:$check r:FLAVOR=assume %i
select -assert-none t:$anyseq t:$anyconst %u t:$allseq %u t:$allconst %u
bmc:   select -assert-count 93 Wt64Top_props/t:$check Wt64Top_props/r:FLAVOR=assert %i
prove: select -assert-count 93 Wt64Top_props/t:$check Wt64Top_props/r:FLAVOR=assert %i
cover: select -assert-count 36 Wt64Top_props/t:$check Wt64Top_props/r:FLAVOR=cover %i
cover: design -save pre_cone
cover: flatten
cover: select -assert-count 23 Wt64Top/c:chk.w1_* Wt64Top/c:chk.w4_* %u Wt64Top/c:chk.w5_* %u Wt64Top/c:chk.w6_* %u Wt64Top/c:chk.w7_* %u Wt64Top/c:chk.w9_* %u Wt64Top/c:chk.w10_cap0_clr %u Wt64Top/c:chk.w11_fire %u Wt64Top/c:chk.w12_* %u Wt64Top/c:chk.w13_* %u Wt64Top/c:chk.w14_* %u Wt64Top/c:chk.w17_* %u Wt64Top/c:chk.w18_* %u Wt64Top/c:chk.w21_* %u Wt64Top/c:chk.w22_* %u Wt64Top/c:chk.w23_* %u Wt64Top/c:chk.w24_* %u Wt64Top/c:chk.w26_* %u Wt64Top/c:chk.w27_* %u Wt64Top/c:chk.w28_* %u
cover: select -assert-none Wt64Top/c:chk.w1_* Wt64Top/c:chk.w4_* %u Wt64Top/c:chk.w5_* %u Wt64Top/c:chk.w6_* %u Wt64Top/c:chk.w7_* %u Wt64Top/c:chk.w9_* %u Wt64Top/c:chk.w10_cap0_clr %u Wt64Top/c:chk.w11_fire %u Wt64Top/c:chk.w12_* %u Wt64Top/c:chk.w13_* %u Wt64Top/c:chk.w14_* %u Wt64Top/c:chk.w17_* %u Wt64Top/c:chk.w18_* %u Wt64Top/c:chk.w21_* %u Wt64Top/c:chk.w22_* %u Wt64Top/c:chk.w23_* %u Wt64Top/c:chk.w24_* %u Wt64Top/c:chk.w26_* %u Wt64Top/c:chk.w27_* %u Wt64Top/c:chk.w28_* %u %ci* Wt64Top/i:*__* %i
cover: select -assert-any Wt64Top/c:chk.w10_cap2_gate %ci* Wt64Top/i:*__* %i
cover: design -load pre_cone

[files]
rtl/generated/Wt64Top.sv
rtl/sv/assert/Wt64Top_props.sv
