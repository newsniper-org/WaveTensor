#
# CompletionUnit 후-formal — 완료 디스크립터 축. 이 모듈의 첫 태스크다
# (완료 디스크립터·명령 링은 직전 파도까지 후-formal 0건이었다).
#
# VERIFIES 는 모델 없는 모듈의 검증 앵커다 — PROVES 는 TLA 모델 가드 전용이고
# (lint_postformal 이 AllGuards 와 대조), 완료 큐·통지에는 이 저장소가 소유한
# 선-formal 모델이 없다 (배압 규약은 Fabric/SharedUnit 이 자기 축에서 다뤘고,
# 그 GUARD-MAP 정식 줄은 FabricMerge.scala 가 소유한다 — 가드당 저장소 전체
# 한 줄 규율이라 여기서 PROVES 로 다시 주장하지 않는다). 아래 앵커는 정본
# 문면(부록 E.5 · E.1.2)과 호스트 ABI 결정 5(2026-08-25)를 근거로 한다.
#
# VERIFIES: CompletionUnit.desc_full_write — 링 칸 32 B *전량 기입*: 되읽은 여덟 워드가 전부 이번 push 의 입력 필드로 재구성한 값과 같다 ⇒ 이전 항목의 어느 워드도 남지 않는다. 잔류의 일반형(임의 초기 내용)이 초기 상태에 들어 있다 — 링 저장소에 reset 이 없기 때문이다
# VERIFIES: CompletionUnit.desc_word_layout — E.5.3 배치: CD_KIND `[7:0]` = `0x01` · CD_TAG0..2 = E.5.1 세 워드 직렬화(TAG1 = 에포크‖poison 0‖trace‖예약 0‖LNID · TAG2 = 예약 0‖정밀도‖차원) · CD_BASE `[7:0]` 결속 LBID · CD_TOTAL `[31:0]` 총개수 그릇 · CD_RSV0/1 = 0. 기대값은 정본 배치로 *독립 재구성*하며 RTL 의 조립을 참조하지 않는다
# VERIFIES: CompletionUnit.cd_tag1_device_authored — CD_TAG1 `[27]` poison 은 장치 저작(원천 0건 — 정본 3.9 · E.1.3)이라 0 이고 입력 사이드밴드의 poison 을 반향하지 않는다 · `[25:16]` 예약 = 0 (E.5.3) · `[26]` trace 와 `[31:28]` 에포크는 보존된다 (01-isa-asm 1.4.4) — a_cd_tag1_poison0 · a_cd_tag1_rsv0 · a_cd_tag1_trace · a_cd_tag1_epoch · 증인 W9(입력 poison = 1) · W10(trace = 1 · 에포크 비0). 재구현 결함 D2c 의 수리(태그 코덱 전파 파도)
# VERIFIES: CompletionUnit.ring_encoding — E.5 1·2항: `head == tail` 빈 링 · `(tail+1) mod size == head` 가득 · 배압(io_comp_ready)이 재구성한 「가득」의 부정과 등가 · 생산 색인은 수락 사이클에만 +1 (E.5 표의 「tail 은 장치 갱신」)
# VERIFIES: CompletionUnit.window_no_leak — 빈 링의 창 읽기는 0: 미기입 저장소를 관측면에 내지 않는다 (E.1.2 창 행). desc_full_write 와 짝 — 살아 있는 칸은 이번 기입을 내고, 살아 있지 않으면 아무것도 내지 않는다
# VERIFIES: CompletionUnit.overflow_sticky — 가득인 링에 밀어 넣기는 loud sticky (§3.8 「오버플로」) 이며 링 상태를 움직이지 않는다 (FAB-10 동형). 발화가 해제를 이긴다 · 명시적 해제 외엔 내려가지 않는다
# VERIFIES: CompletionUnit.unaligned_read_zero — 비정렬 읽기(주소 하위 두 비트 ≠ 0)의 응답은 다음 사이클 rvalid + 0 이다 — 창 포함 구역 전역 (03-hiu.typ:874 「비정렬 *읽기*는 0 · fault 없음이다」 · fault 없음은 축 6 등식) · 비어 있지 않은 링의 창 비정렬 읽기 증인 W8. 파도 4 W6 검토가 찾은 미측정(winSel 의 aligned 탈락이 통과한 변이 M12)을 닫는다
# VERIFIES: CompletionUnit.drain_allzero_pin — W4 (3.10 v1.0 묶음 · DP-5): 클래스 끝 출력 drainAllZero(io 번들 밖 — 하네스 넷 io_drainAllZero · = `0xE14` 의 D 원천 — ActivePart.io_drainNow) 는 정본 E.11 일곱 항(여섯 드레인 입력 전부 0 ∧ 자기 완료 큐 점유 0 — 노출 포인터로 재구성)의 조합 술어와 매 사이클 같고 (a_daz_fn), 수락된 정렬 `0x37C` DRAIN_ALLZERO 읽기의 다음 사이클 응답은 같은 술어의 수락 사이클 값이다 (a_daz_rd) — 「핀 = `0x37C` 읽기 = 여섯 입력 전부 0」 의 합성. **무계 증명**(prove_daz — abc pdr, 두 단언만 남긴 판)과 bmc 가 함께 잰다. 증인 W11(읽기 1) · W12(CQ_OCC 항 — 여섯 0 인데 핀 0) · W13(파이프 항 — 읽기 0). 시점(t 접수가 t+1 핀에 든다)은 HiuMask/occ.sby h_occ_accept · h_occ_conserve + assembly a_drain_order 의 합성 — 이 단언은 술어가 조합이라는 것(래치 없음)을 든다
# PROVES: MmioPage.unaligned_rejected — 유닛 절반(완료 구역): 비정렬 쓰기 ⇒ 다음 사이클 faultBadWrite — 거절 사유를 정본 표로 독립 재구성한 차기 상태 등식(축 6 · 증인 W6). 조립 구역과 own · cfg 는 다른 태스크다 (lint_postformal _PARTIAL 등재)
# PROVES: MmioPage.nocons_rejected — CQ_BASE 절반: CQ_BASE_LO/HI(+0x00 · +0x04) 정렬 쓰기 ⇒ 다음 사이클 faultBadWrite (축 6 등식 · 증인 W7) · 되읽기 0 은 readValue 가 두 워드를 덮지 않는 구조다(이 태스크는 값 경로를 창 읽기로만 잰다). 명령 링 넷(0x380–0x390)은 Wt64Top/assembly.sby (lint_postformal _PARTIAL 등재)
#
# ══ 이 태스크가 재지 *않는* 것 — 정직 표기 ═══════════════════════════════
#
#  · **명령 방향.** 명령 디스크립터를 조립하는 회로가 없다 (E.1.3 UNWIRED).
#    「태그가 양방향에서 같은 상대 오프셋」의 두 방향 대조는 elaborate 시점
#    require(`HostDesc`)가 들고, 여기서는 완료 방향 절반만 잰다. 회로 없는
#    쪽을 형식 검사가 덮는다고 적으면 그것이 좁은 증명의 넓은 주장이다.
#  · **k-귀납(prove)이 없다.** 되읽기 등식의 귀납 불변은 `ring[f_slot] ==
#    그림자` 인데 링 저장소가 포트로 노출되지 않아 적을 수 없다. BMC 는
#    reset 부터 깊이 14 까지 전수이고, 잔류의 일반형이 그 초기 상태에 있다.
#    「덮인 깊이 안에서 전수」와 「무한 깊이」는 다르다 — 그 차이가 여기 있다.
#  · IRQ 마스크(E.6)는 이 태스크의 축이 아니다. 후속 파도 몫이며 미측정이지
#    통과가 아니다. 드레인 집계(E.11)는 W4 가 축 7 로 세웠다 — 핀 · `0x37C` 읽기 · 일곱 항. 거절된 구성 기입(E.1.1)은 파도 4 가 축 6 으로
#    세웠다 — sticky 의 차기 상태 등식(비정렬 · RO · CQ_BASE · 예약 · CQ_SIZE 값). 거절된
#    기입이 레지스터(head · IRQ 마스크)를 움직이지 않는다는 절반은 재지 않는다.
#
# ══ 깊이 근거 ═════════════════════════════════════════════════════════════
#
# 가장 긴 검사 열은 「push → 창 주소 제시 → 다음 사이클 rdata」 3스텝이고,
# reset 한 사이클과 f_reset_d 한 사이클을 더해 5 가 하한이다. bmc 10 은 그
# 2배이며(지침의 「2배 이상」), head 배수(호스트 CQ_HEAD 기입) → 재push →
# 재읽기의 왕복이 그 안에 든다.
#
# cover 는 14 다 — 증인이 더 긴 열을 요구한다. 「가득」은 head 가 호스트
# 기입으로 움직이므로 짧게 닿지만(실측 step 3), 여덟 워드 색인 증인과 태그
# 전 필드 비영 증인이 여유를 쓴다. cover 는 반례 탐색이 아니라 도달 탐색이라
# 깊이가 비용에 거의 들지 않는다 (실측 1초).
#
# ══ memory_map 이 필요한 이유 — 비용 실측 ══════════════════════════════════
#
# 링 저장소를 SMT array 로 두면 256b 원소와 배열 이론이 겹쳐 z3 가 **step 9
# 에서 10분+ 미종료**였다 (실측 2026-08-25). `memory_map` 으로 비트벡터만
# 남기면 같은 깊이가 **2분**에 끝난다. DecodeWalk/OperandDecode 가 같은 패스를
# 쓰는 이유는 ROM 함정(귀납에서 내용이 임의화됨)이지만, 여기서는 *비용*이다 —
# 목적이 다르므로 각자 사유를 적는다.
#
# ══ 공허 아님의 검산 — 실측 ════════════════════════════════════════════════
#
# design_prep.il 의 `cell $assert|$cover` 수 > 0 (make rtl-postformal 의 HOLLOW
# 게이트) 과 cover 태스크의 증인 도달을 함께 본다. 특히 여덟 워드 색인 각각의
# cover 가 도달해야 축 2 가 여덟 워드 전부에서 비공허다.
#
# 실측 (파도 4 페이지 통합판): bmc assert 9 · cover 14, **cover 14 전부 도달** (여덟 워드 색인
# + 가득 + 오버플로 + 빈 창 + 태그 전 필드 비영 되읽기 + 비정렬 쓰기 거절 W6 + CQ_BASE 쓰기 거절 W7).
# 앞 판은 assert 8 · cover 12 였다 — 축 6(거절된 구성 기입의 차기 상태 등식)이 하나 · 증인 둘을 더했다.
# 축 6 의 변이 실측(비상주): isBase 항 탈락 · 비정렬 항 탈락 둘 다 bmc FAIL (rtl/README.md 파도 4 페이지 통합 절).
#
# 실행(컨테이너 전용 — 호스트 sby 금지):
#   podman run --rm --userns=keep-id -v "$PWD:/workspace" wavetensor-dev:scala \
#     sh -lc "cd /workspace && sby -f --prefix /tmp/sby-CompletionUnit \
#             rtl/formal/sby/CompletionUnit/descriptor.sby"

# ── 역-변이 표 — CD_TAG1 (태그 코덱 전파 파도, 2026-09-26 · 비상주: 생성물 사본에 한 줄씩, bmc) ──
#   CM1  poison 자리 ← io_comp_tag_poison (D2c — 사이드밴드 반향)   ⇒ a_cd_tag1_poison0 (· 축 2 등식)
#   CM2  예약 [25:16] ← {trace, 0…} (옛 스레드 상위 비트의 부류)     ⇒ a_cd_tag1_rsv0 (· 축 2 등식)
#   CM3  trace 자리 ← 0 (보존 탈락)                                 ⇒ a_cd_tag1_trace (· 축 2 등식)
#   셋 다 사살 (rc=2 — 게이트 자신의 bmc 태스크 엔진 smtbmc z3 · CM1 은 2026-09-27 같은 엔진에서 재사살, 벽시계 1 초). 실측 판: bmc assert 15 · cover 17 전부 도달 (W9 · W10 신설).

# ## 역-변이 표 — W4 축 7 (drainAllZero 핀 · 0x37C 읽기, 2026-10-15 후-formal 통합 · 비상주)
#
# 사본의 CompletionUnit 한 식(생성물 CompletionUnit.sv sha256 9b8749d942c3a315). bmc = smtbmc --keep-going z3 깊이 10
# (위반 전수) · cover = 이 파일 그대로(smtbmc z3 깊이 14) · prove_daz = 이 파일 그대로(abc pdr). 무변이: 셋 PASS · 20/20.
#
#   변이                                                 bmc 위반 (= prove_daz)   미도달 증인
#   PIN_NO_OCC   핀이 CQ_OCC 항을 뺀다 (여섯 0 이면 1)      a_daz_fn                W12
#   PIN_NO_PIPE  핀이 파이프 항을 뺀다                      a_daz_fn                —
#   PIN_LATCH    핀 = 한 사이클 늦은 allZero (래치)          a_daz_fn                —
#   RD_NO_OCC    0x37C 읽기 값이 점유 1 을 0 으로 본다        a_daz_rd                —
#   RD_NO_PIPE   0x37C 읽기 값이 파이프 항을 뺀다             a_daz_rd                W13
#   RD_CONST0    0x37C 읽기 값 상수 0                         a_daz_rd                W11
#
# 두 단언 · 증인 셋 전부 단독 사살 변이가 있다. 축 7 밖 단언 열다섯은 여섯 변이 모두에서 PASS 다.
# HEAD(f67e3d6) 음성 대조: 직접 부착 ERROR — CompletionUnit 에 `drainAllZero` 포트가 없다.
#
[tasks]
bmc
cover
prove_daz

[options]
bmc: mode bmc
bmc: depth 10
cover: mode cover
cover: depth 14
prove_daz: mode prove
# 반례 재생 전용 — 판정 엔진이 아니다 (door.sby 선례)
prove_daz: aigsmt z3
multiclock off

# prove_daz (W4) — 축 7 의 두 단언만 남긴 판의 무계 증명. 나머지 축은 귀납 불변이 링 저장소를 요구해(머리
# 「k-귀납(prove)이 없다」) 이 태스크에서 chformal 로 지운다. 엔진은 abc pdr — z3 를 판정에 쓰지 않는다
# (메모리 「솔버 실명 함정」). bmc · cover 는 앞 판 그대로 smtbmc z3 (작은 설계 · 실측 분 단위).
[engines]
bmc: smtbmc z3
cover: smtbmc z3
prove_daz: abc pdr

[script]
# expose + 래퍼 부착 — bind 미사용 사유는 CompletionUnit_props.sv 파일 머리.
read_verilog -formal CompletionUnit.sv
expose CompletionUnit/w:head CompletionUnit/w:tail
read_verilog -formal -sv CompletionUnit_props.sv
prep -top CompletionUnit_formal
# 링 저장소를 순수 논리로 전개한다 — DecodeWalk/OperandDecode 가 ROM 함정
# 때문에 쓴 것과 같은 패스이고, 여기서는 *비용*이 이유다. 실측: 배열을 SMT
# array 로 두면 256b 원소 + 배열 이론이 겹쳐 z3 가 step 9 에서 10분+ 미종료
# 였고, memory_map 으로 비트벡터만 남기면 전 깊이가 분 단위로 끝난다.
memory_map
async2sync
prove_daz: chformal -assert -cover -remove CompletionUnit_props/c:* CompletionUnit_props/c:a_daz_* %d
prove_daz: select -assert-count 2 CompletionUnit_props/t:$assert

# [files] 경로는 저장소 루트 기준이다 — sby 는 상대 경로를 sby 파일이
# 아니라 *호출 cwd* 기준으로 푼다 (스윕 실측: ../ 경로가 루트 호출에서 깨짐).
# make rtl-postformal · 스윕 · 수동 실행 전부 루트에서 호출하는 것이 규약이다.
[files]
rtl/generated/CompletionUnit.sv
rtl/sv/assert/CompletionUnit_props.sv
