#
# 변환 저장소의 호스트 쪽 문 — 상한 아래 형상(파티션 2)의 측정 (파도 4, 2026-09-26).
# 선-formal 계약: rtl/formal/tla/XlateSurface.tla 의 BelowCap 판 (XlateSurface_phantom.cfg ·
# 판정 T4 (ii) — e-defined.typ:424 「상한 아래 형상에서는 그 주소가 없는 파티션을 가리키고」).
#
# PROVES: XlateSurface.ent_part_exists — 문 절반: 항목 배열의 형상 밖 주소(addr[8:7] ≥ 2)의 LO · HI 는 커밋 · 정지 없음 + badWrite (p_ent_phantom · p_bad_iff) · 형상 밖 LO 는 스테이징을 쓰지 않는다(그림자 갱신 규칙 loAcc + p_commit_iff — 쓰는 DUT 는 앞서 스테이징된 실재 항목의 HI 에서 깨진다) · 절단 별칭(1b commit.part)으로 실재 항목이 설치되는 커밋이 서지 않는다. 표 불변의 하류 절반은 _PARTIAL
# PROVES: XlateSurface.flush_part_exists — 문 절반(파티션 2 형상): [7:0] ≥ 2 의 XLATE_FLUSH 는 flush 없음 + badWrite (p_flush_iff · p_bad_iff) — 1b flush.part 로 자르는 별칭이 없다. 기본 형상의 [7:0] ≥ 4 는 props.sby. 표 불변의 하류 절반은 _PARTIAL
#
# ## 왜 이 태스크가 따로 있는가
#
# 기본 형상(파티션 4 — 인코딩 상한)의 생성물에서 항목 배열의 형상 밖 가지
# (XlateStaging.entPhantom)는 elaborate 상수 False 다 — props.sby 는 그 가지를 원리적으로
# 재지 못한다. 형상은 상한 아래에서 자유이므로 —
#   e-defined.typ:799 「형상은 그 상한 아래에서 자유이고」
# 그 가지가 서는 형상이 따로 elaborate 돼야 판정 T4 의 처분이 측정된다.
# GenXlateStaging 이 파티션 2 판(XlateStagingP2)을 낸다 — GenSharedUnit(깊이 0) ·
# GenStepSequencer(P = 1) 선례의 경계 형상 elaborate.
#
# 하네스는 props.sby 와 같은 XlateStaging_props.sv 이고 매크로 XLATESTG_P2 가 형상 상수 ·
# 대상 모듈 · 형상 밖 파티션 단언(p_ent_phantom) · 증인 W17–W19 를 켠다 (하네스 머리
# 「형상」). bmc · prove 는 그 하네스의 단언 전부를 파티션 2 형상에서 다시 잰다 — 앵커로
# 주장하는 것은 형상에 매인 위 둘이다.
#
# ## 이 태스크가 재지 않는 것
#
#   · 파티션 2 형상의 *조립* — Wt64Top 의 xlateArea(partW = 1 결선 · 주소 디코드)는 기본
#     형상 하나로만 elaborate 되고 Wt64Top/assembly.sby 가 그것을 잰다. 파티션 2 조립은
#     어느 태스크도 재지 않는다 (assembly.sby 「보증하지 않는 것」).
#   · 표 효과 — props.sby 와 같다 (XlateStore 의 프레임 조건 — xlatestore.sby).
#   · 색인 축의 형상 밖 주소 — 이 구현은 색인 16 고정이라(XlateStore 의 8 B 폭 require)
#     addr[6:3] 이 실재하지 않는 색인을 표현하지 않는다.
#
# ## 엔진 · 깊이 — props.sby 와 같다
#
# prove 는 abc pdr (그림자 스테이징 오라클 — props.sby 머리의 근거), bmc 는 abc bmc3,
# cover 는 smtbmc z3. 가장 깊은 증인(W18 — LO → 형상 밖 HI)이 reset 뒤 3 사이클이면
# 닿는다. bmc 12 · cover 10.

[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 12
prove: mode prove
cover: mode cover
cover: depth 10
multiclock off
bmc: aigsmt z3
prove: aigsmt z3
timeout 600

[engines]
bmc: abc bmc3
prove: abc pdr
cover: smtbmc z3

[script]
# 증인(cover)은 cover 태스크에서만 컴파일한다 — bmc/prove 모델은 한 비트도
# 다르지 않게 유지한다 (props.sby 선례).
bmc:   read_verilog -sv -formal -DXLATESTG_P2 XlateStaging_props.sv
prove: read_verilog -sv -formal -DXLATESTG_P2 XlateStaging_props.sv
cover: read_verilog -sv -formal -DXLATESTG_P2 -DXLATESTG_COVER XlateStaging_props.sv
read_verilog -sv -formal XlateStagingP2.sv
prep -top XlateStaging_check

# [files] 경로는 저장소 루트 기준이다 — sby 는 상대 경로를 sby 파일이 아니라
# *호출 cwd* 기준으로 푼다.
[files]
rtl/generated/XlateStagingP2.sv
rtl/sv/assert/XlateStaging_props.sv
