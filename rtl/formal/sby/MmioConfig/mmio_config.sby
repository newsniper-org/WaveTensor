# SPDX-FileCopyrightText: 2026 윤병익 (BYUNG-IK YEUN) and WaveTensor contributors
#
# MmioConfig 후-formal — 서로소 기입 거절(D2)·원자성(§3.7.1) 재검사 (§6.3).
#
# PROVES: Route.view_sync — 구동 절반: 표 기입(fwd·rev·lbid)과 뷰 구동(viewWr·bankWr)이 동일 사이클·동일 조건·동일 내용, 그 외 뷰 구동 경로 없음 (반영 절반은 RouteJudge, 합성은 RouteMmio)
#
# 증명(위임) — Route 모델의 unique_owner 가드: GUARD-MAP 이 DELEGATED(MmioConfig)
# 로 이 모듈을 지목한다. lint_postformal 규칙(앵커는 CHECK 가드 전용)에 따라
# PROVES 앵커는 세우지 않되, 실측 대상은 이 파일이다 — 이행 지점 chkDupOwn 의
# 「쓰기 무효(표·역방향 표·뷰 전부) + loud sticky faultDupOwner」. 표 *내용*
# 수준의 서로소 불변식은 mmio_deep.sby 가 잰다.
#
# bmc 깊이 24 근거: 초기화 소거가 2^16 사이클이라 reset 기점 BMC 는 소거
# 구간만 실측한다 (소거 중 침묵·ready 저지·reset 직후 상태 — 정직 표기는
# 하네스 머리 주석). 기능 구간은 prove(k-귀납)가 도달성과 무관하게 덮는다.
# prove 깊이 6 근거: 속성 전부 조합 등식 또는 1스텝($past) 관계 — k=2 로
# 족하고 여유로 6.
#
# cover 태스크 (2026-08-24 신설, -DMMIO_COVER) — 공허 PASS 방지.
# 이 파일의 단언은 「A 이면 B」 꼴이 대부분이라 A 가 충족 불가능하면 전부
# 공허하게 통과한다. 특히 엔트리 예약 비트 엄격화(결정 A)로 신설한 거절
# 단언들이 그렇다. cover 는 그 전제가 실제로 충족됨을 증인으로 보인다:
# 예약 비트 비0 기입의 거절(LNID·LBID 두 축) · 그 거절의 sticky 발화 ·
# 그리고 반대 방향으로 적법 기입의 커밋/해제 (엄격화가 정상 경로를 삼키지
# 않았다는 증거 — 거절 증인만 두면 「전부 거절하는 기계」도 통과한다).
#
# cover 의 시작 상태 (정직 표기): reset 기점으로는 소거 2^16 사이클 때문에
# ready 가 서는 구간에 원리적으로 닿지 못한다. 그래서 이 태스크만 reset 을
# 인가하지 않고 「소거 완료 직후」의 관측 상태(initDone·!busy·fault 없음)를
# t=0 에 assume 한다. 즉 이 태스크가 주장하는 것은 「단언의 전제가 충족
# 가능하다」이지 「reset 으로부터 도달 가능하다」가 아니다 — 단언이 서는
# 영역(k-귀납의 자유 상태)과 같은 영역에서 증인을 잡는다. 소거 자체의
# 성질은 위 bmc 태스크가 따로 잰다. 단언은 이 태스크에서 꺼진다.
#
# 실행(컨테이너 전용 — 호스트 sby 금지):
#   podman run --rm --userns=keep-id -v "$PWD:/workspace" wavetensor-dev:scala \
#     sh -lc "cd /workspace && sby -f --prefix /tmp/sby-MmioConfig \
#             rtl/formal/sby/MmioConfig/mmio_config.sby"

[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 24
prove: mode prove
prove: depth 6
cover: mode cover
cover: depth 6

[engines]
smtbmc z3

[script]
# bind 는 yosys 0.66 자유 프론트엔드가 조용히 버린다 (2026-08-24 실측) —
# expose 로 내부 신호를 포트로 승격해 하네스가 직접 인스턴스한다.
bmc:   read_verilog -formal -sv MmioConfig.sv MmioConfig_props.sv
prove: read_verilog -formal -sv MmioConfig.sv MmioConfig_props.sv
cover: read_verilog -formal -sv -DMMIO_COVER MmioConfig.sv MmioConfig_props.sv
expose MmioConfig/w:initDone MmioConfig/w:busy MmioConfig/w:pSlot MmioConfig/w:pWord
expose MmioConfig/w:revChkPresent MmioConfig/w:fwdRd MmioConfig/w:chkDupOwn MmioConfig/w:chkBadWr MmioConfig/w:chkLbBadWr
expose MmioConfig/w:fwdWrEn MmioConfig/w:fwdWrAddr MmioConfig/w:fwdWrData
expose MmioConfig/w:revWrEn MmioConfig/w:revWrAddr MmioConfig/w:revWrData
expose MmioConfig/w:lbWrEn MmioConfig/w:lbWrAddr MmioConfig/w:lbWrData
prep -top MmioConfig_props

# 경로는 저장소 루트 기준 — sby 는 [files] 를 호출 cwd 기준으로 푼다 (실측).
[files]
rtl/generated/MmioConfig.sv
rtl/sv/assert/MmioConfig_props.sv
