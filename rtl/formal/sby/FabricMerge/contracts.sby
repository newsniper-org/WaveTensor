# SPDX-FileCopyrightText: 2026 윤병익 (BYUNG-IK YEUN) and WaveTensor contributors
#
# PROVES: Fabric.single_producer — selOh(포인터·포획 포함) one-hot 불변 → 사이클당 버스 구동 생산자 ≤ 1 (FAB-1)
# PROVES: Fabric.valid_gated — 구동 lane 존재 시 소비자 페이로드가 그 lane 의 face 와 비트 단위 등식 — 비구동 lane 의 낡은 face 는 병합에 실리지 않는다 (FAB-9)
# PROVES: Fabric.valid_tracks_data — vld 상승의 유일한 원인은 doPush 이고 같은 사이클에 face 가 밀어넣은 값으로 쓰인다
# PROVES: Fabric.capture_atomic — pop ⊆ 소비자 수락(같은 사건), 점유 감소의 유일한 원인도 수락된 핸드오프 (FAB-5)
# PROVES: Fabric.stall_on_pending — stall = full 수출 + full 사이클엔 face 에 닿는 쓰기 없음 + pop 없인 점유 불변
# PROVES: Fabric.bp_loud — strb ∧ stall(shove) 은 다음 에지에 io_fault 를 세운다 — 조용한 소실 아님 (§2.6 규범 4항)
# PROVES: Fabric.fault_raised — shoveAny 의 클록 에지에 상태 비트가 선다 (faultClear 동시라도 set 우선)
# PROVES: Fabric.fault_sticky — fault ∧ ¬faultClear ⇒ 다음 사이클에도 fault — ready 상승 포함 어떤 입력도 내리지 못한다
# PROVES: Fabric.bp_no_consumer_write — valid ∧ ¬ready 동안 valid 유지 + 페이로드 비트 단위 불변 (FAB-10)
#
# fair_grant 는 fairness.sby (BMC 전용), bp_relief 는 ENV (RTL 검사 아님 —
# GUARD-MAP 문면: 소비자/호스트 의무, 뿌리는 부록 E 호스트 ABI).
#
# bmc 깊이 20 근거: FabricMerge 는 조합 병합 + 깊이 1 출력 자원 + 1단 선택
# 잠금 — 유효 파이프 깊이 ≤ 2. 규율(파이프 깊이 2배 이상)의 기본값 20.
# prove 는 k-귀납, k = 6: 모든 속성이 상태창 ≤ 2 사이클(즉시 불변식 + $past
# 1단)이라 이론상 k = 2-3 이면 닫히고, 6 은 그 3배 여유다. k 를 20 까지
# 올리는 것은 귀납 단계 SMT 질의만 키운다 (실측 z3 로 k=6 즉시 폐합).
# 귀납을 닫는 힘은 하네스의 one-hot 보조 불변식들이다.
#
# 부착 방식: OSS yosys 는 bind 를 파싱만 하고 적용하지 않는다 (실측 —
# 하네스 머리 주석 참조). 그래서 expose 로 내부 신호를 포트로 승격한 뒤
# FABRICMERGE_EXPOSE_FLOW 의 FabricMerge_formal 래퍼가 bind 문과 1:1 동일한
# 결선을 잇는다. 대상 SV 는 무수정 — 승격은 yosys 통과 중의 변환일 뿐이다.
#
# ── cover 증인 (2026-08-26 신설, -DFABRICMERGE_COVER_CONTRACTS) ────────────
#
# 왜 필요한가. 이 태스크의 단언 50 개 중 **41 개가 전건을 가진 함의**다
# (lane 축 9 × 4 + 모듈 축 5 — 함의로 쓰인 `!P || Q` 포함). 전건이 도달
# 불가능하면 그 단언은 *공허하게 참*이고, 이 저장소가 이미 세운 두 게이트는
# 그것을 잡지 못한다: 셀 수는 그대로 세어지고, 항진 검사(`connect \A` 상수화)
# 도 `!P || Q` 를 상수로 접지 못한다 — P 가 죽어 있어도 그 식은 상수가 아니다.
# 공허의 넷째 결이고, 검출 수단은 「전건이 성립하는 궤적의 도달성」뿐이다.
#
# 남은 9 개는 전건이 없는 등식(`consumer_valid == (drive != 0)` 1 + lane 축
# `stall[gi] == full[gi]` 4 + one-hot 4)이다. 앞의 다섯은 전건이 아니라
# **양변이 늘 0/거짓인 세계**에서 공허해지고, one-hot 넷은 `$onehot0(drive)`
# 처럼 「구동 집합이 늘 비어 있으면」 자명하다 — 결이 다르므로 증인도 따로
# 세운다 (WC2 · WC3 · WL1 · WL7).
#
# 계약 축이 묻는 것: **병합 충돌이 실제로 일어나는가.** WL2(lane 축)와
# WC3(모듈 축)이 그 중심이다 — 구동 lane 하나와, 버스와 다른 비0 face 를 든
# 경쟁 lane 이 같은 사이클에 공존하는 궤적. 이것이 도달 불가능하면 FAB-9 의
# 등식 `consumer_pay == face[gi]` 는 「경쟁자가 없는 세계」의 자명한 참이다.
# 증인은 lane 마다 따로 선다 — 「어느 한 lane 이 구동한다」로 뭉치면
# 라운드로빈이 특정 lane 에 영영 닿지 못하는 세계를 배제하지 못한다.
#
# 나머지 증인의 대응은 하네스 주석이 단언 문면과 1:1 로 적는다 (WL1..WL8 ·
# WC1..WC10). 특기할 둘:
#   · WL7 — full 인 자원에 *실제 쓰기 시도*가 닿는 궤적. 이것 하나가
#     stall_on_pending ①②와 bp_loud 셋의 공통 활성면이다.
#   · WC7 — fault 가 영구 1 이 아니라는 반대면. 전건 도달성과는 다른 결의
#     공허(후건이 상수 참)이고 같은 단언 묶음에 함께 걸린다.
#
# 증인이 보증하지 않는 것 (과대 주장 금지 — 실측 기록): cover 모드는
# `chformal -assume -early` 로 assume 만 남기고 `-assert -remove` 로 단언을
# 제거한다. 그래서 증인 궤적은 「단언을 만족하도록 제약된」 궤적이 아니라
# 리셋 규약만 지킨 도달 가능 궤적이다. 결론이 서는 것은 같은 파일의 prove
# 태스크가 k-귀납으로 *모든* 도달 가능 상태를 덮기 때문이다 — prove 가
# 깨지면 증인의 해석도 함께 무너진다. 둘을 따로 읽지 말 것.
#
# cover 깊이 14 근거: 가장 깊은 증인은 WL2 의 상위 lane 판(라운드로빈 포인터를
# 한 번 돌려 놓아야 상위 lane 이 구동하면서 경쟁자를 갖는다 — 리셋 1 + 채움 1
# + 첫 grant 1 + 재채움 1 + 충돌 1 ≈ 5)과 WC7(리셋 1 + 채움 1 + shove 1 +
# 상승 1 + 해제 1 ≈ 5)이다. 14 는 그 3배 여유고, bmc 의 20 보다 얕게 두는
# 것은 증인 탐색이 반례 탐색보다 얕은 곳에서 끝나기 때문이다.

[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 20
prove: mode prove
prove: depth 6
cover: mode cover
cover: depth 14

[engines]
smtbmc z3

[script]
read -define FABRICMERGE_NO_FAIR
read -define FABRICMERGE_EXPOSE_FLOW
# 증인은 cover 태스크에서만 컴파일한다 (HiuMask -DHIUMASK_COVER 선례) —
# bmc/prove 모델은 단언만 들어 태스크별 셀 수가 정확히 대조된다.
cover: read -define FABRICMERGE_COVER_CONTRACTS
read -formal -sv FabricMerge.sv
hierarchy -top FabricMerge
proc
expose FabricMerge/w:lanes_0_slots_0_head_tag_wave FabricMerge/w:lanes_0_slots_0_head_tag_epoch FabricMerge/w:lanes_0_slots_0_head_tag_poison FabricMerge/w:lanes_0_slots_0_head_tag_trace FabricMerge/w:lanes_0_slots_0_head_tag_lnid FabricMerge/w:lanes_0_slots_0_head_tag_precision FabricMerge/w:lanes_0_slots_0_head_tag_dim FabricMerge/w:lanes_0_slots_0_head_seq FabricMerge/w:lanes_0_slots_0_head_total FabricMerge/w:lanes_0_slots_0_head_last FabricMerge/w:lanes_0_slots_0_body FabricMerge/w:lanes_1_slots_0_head_tag_wave FabricMerge/w:lanes_1_slots_0_head_tag_epoch FabricMerge/w:lanes_1_slots_0_head_tag_poison FabricMerge/w:lanes_1_slots_0_head_tag_trace FabricMerge/w:lanes_1_slots_0_head_tag_lnid FabricMerge/w:lanes_1_slots_0_head_tag_precision FabricMerge/w:lanes_1_slots_0_head_tag_dim FabricMerge/w:lanes_1_slots_0_head_seq FabricMerge/w:lanes_1_slots_0_head_total FabricMerge/w:lanes_1_slots_0_head_last FabricMerge/w:lanes_1_slots_0_body FabricMerge/w:lanes_2_slots_0_head_tag_wave FabricMerge/w:lanes_2_slots_0_head_tag_epoch FabricMerge/w:lanes_2_slots_0_head_tag_poison FabricMerge/w:lanes_2_slots_0_head_tag_trace FabricMerge/w:lanes_2_slots_0_head_tag_lnid FabricMerge/w:lanes_2_slots_0_head_tag_precision FabricMerge/w:lanes_2_slots_0_head_tag_dim FabricMerge/w:lanes_2_slots_0_head_seq FabricMerge/w:lanes_2_slots_0_head_total FabricMerge/w:lanes_2_slots_0_head_last FabricMerge/w:lanes_2_slots_0_body FabricMerge/w:lanes_3_slots_0_head_tag_wave FabricMerge/w:lanes_3_slots_0_head_tag_epoch FabricMerge/w:lanes_3_slots_0_head_tag_poison FabricMerge/w:lanes_3_slots_0_head_tag_trace FabricMerge/w:lanes_3_slots_0_head_tag_lnid FabricMerge/w:lanes_3_slots_0_head_tag_precision FabricMerge/w:lanes_3_slots_0_head_tag_dim FabricMerge/w:lanes_3_slots_0_head_seq FabricMerge/w:lanes_3_slots_0_head_total FabricMerge/w:lanes_3_slots_0_head_last FabricMerge/w:lanes_3_slots_0_body FabricMerge/w:lanes_0_cnt FabricMerge/w:lanes_1_cnt FabricMerge/w:lanes_2_cnt FabricMerge/w:lanes_3_cnt FabricMerge/w:lanes_0_full FabricMerge/w:lanes_1_full FabricMerge/w:lanes_2_full FabricMerge/w:lanes_3_full FabricMerge/w:lanes_0_vld FabricMerge/w:lanes_1_vld FabricMerge/w:lanes_2_vld FabricMerge/w:lanes_3_vld FabricMerge/w:lanes_0_doPush FabricMerge/w:lanes_1_doPush FabricMerge/w:lanes_2_doPush FabricMerge/w:lanes_3_doPush FabricMerge/w:lanes_0_doPop FabricMerge/w:lanes_1_doPop FabricMerge/w:lanes_2_doPop FabricMerge/w:lanes_3_doPop FabricMerge/w:lanes_0_shove FabricMerge/w:lanes_1_shove FabricMerge/w:lanes_2_shove FabricMerge/w:lanes_3_shove FabricMerge/w:select_req FabricMerge/w:select_ptrOh FabricMerge/w:select_lockedOh FabricMerge/w:select_locked FabricMerge/w:select_selOh FabricMerge/w:select_drive FabricMerge/w:io_consumer_fire FabricMerge/w:shoveAny
read -formal -sv FabricMerge_props.sv
prep -top FabricMerge_formal

# [files] 경로는 저장소 루트 기준이다 — sby 는 상대 경로를 sby 파일이
# 아니라 *호출 cwd* 기준으로 푼다 (스윕 실측: ../ 경로가 루트 호출에서 깨짐).
# make rtl-postformal · 스윕 · 수동 실행 전부 루트에서 호출하는 것이 규약이다.
[files]
rtl/generated/FabricMerge.sv
rtl/sv/assert/FabricMerge_props.sv
