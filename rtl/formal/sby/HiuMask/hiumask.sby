#   HW9    faultOwn = _zz_io_faultPerm (원천 혼선)
#          own_reported           ⇒ bmc ⇒ o_own_loud (step 9 · 47s)
#   HW1P   HW1 + ownViol = 1'b0 (짝 「오늘의 RTL」 꼴)
#          —                      ⇒ bmc ⇒ o_own_loud o_perm_rise (step 9 · 68s)
#   HW1Pi  HW1P · 격리 o_perm_rise
#          —                      ⇒ bmc ⇒ o_perm_rise (step 9 · 16s)
#   HW1Pj  HW1P · 격리 o_own_loud
#          —                      ⇒ bmc ⇒ o_own_loud (step 9 · 5s)
#   HH0    HEAD 3b80087 HiuPipeline.sv + 포트 스텁(faultOwn = 0)
#          음성 대조                  ⇒ bmc ⇒ o_own_loud o_perm_rise (step 9 · 39s)
#   HH0i   HH0 · 격리 o_perm_rise
#          음성 대조                  ⇒ bmc ⇒ o_perm_rise (step 9 · 12s)
#   HH0j   HH0 · 격리 o_own_loud
#          음성 대조                  ⇒ bmc ⇒ o_own_loud (step 9 · 17s)
#   HH1    HEAD 3b80087 HiuPipeline.sv 그대로
