#          latch_one_value        ⇒ props:584 (캡처 frame 줄) l_hold @7 (26s) · 격리 l_one_value @8
#
# 라벨 ↔ 그것만 죽이는 변이 (전 단언 bmc 의 첫 적발이 그 라벨 하나):
#   l_hold MF1 (fromFill) · MP1 은 q_hit_perm 이 먼저 — 격리 l_hold @7 · MV1 격리 l_hold @7 (수락 기준 (2))
#   e_cap_hit ME1 @7 · e_cap_fill MF2 @6 · q_hit_frame MA1 @4 · MR1 @6 · MV1 @5 · q_hit_perm MP1 @5 · q_miss_frame MQ1 @1 ·
#   q_miss_perm MQ2 @1 · MC1 · MC2 · MC3 @5 · MZ1 @1 · d_stall_src MD1 @5 (MN1 · MG1 은 m_obs_stall 과 같은 스텝 — 격리 d_stall_src @5) ·
#   m_sticky MS1 @7 (수락 기준 (3)) · m_obs_stall MS2 @5 · m_obs_zero MS3 @5 · m_obs_part MH3 @4 · m_obs_vpn MH2 @4 ·
#   l_one_value MO1 @8 · MO2 @7 (MO3 은 l_hold · 캡처 frame 줄이 먼저 — 격리 l_one_value @8).
# l_clear 와 l_capture_gated 는 격리에서만 단독으로 운다 — 위 해설대로 d_stall_src · q_* 의 사영이라 형제를
# 둔 채 그것만 죽이는 변이가 원리적으로 없다 (o_ent_blocked 와 같은 처분 — lint_postformal _DERIVED 등재
# 대상). 수락 기준 셋: (1) l_clear 는 연속 전진 에지에서 운다 — 「연속 전진」 열 넷이 그 실측이고, 기본
# 하네스의 MC1 격리 반례도 그 꼴이다(떠나는 에지에 s2 유효 · 다음 사이클 s3 유효 ∧ 미적중 ∧ 정지 안 함 —
# 앞 요청의 판정을 물려받았다). (2) l_hold 는 값 쪽 마지막 대입 삭제(MV1 — 대안 value_no_latch)를
# 격리에서 잡는다 (전 단언에서는 같은 결함을 q_hit_frame 이 두 스텝 먼저 잡는다). (3) m_sticky 는 sticky
# set = 원시 미적중(MS1 — 대안 sticky_raw_miss)을 단독으로 잡는다.
#
# 증인 ↔ 미도달로 만드는 변이 (cover btormc d60):
#   W29 ← KW29 XlateStore 가 같은 조회 키에 한 번 적중하면 키가 바뀌거나 조회가 내려갈 때까지 적중을 유지 (W29 · W36 미도달 —
#         둘 다 「판정된 요청이 항목을 잃은 채 머문다」를 전건으로 든다. W29 만 지우는 변이는 찾지 못했다: 전건이 지상
#         진리 · XlateStore 출력 · 환경 입력 io_hold 로만 적혀 W1 engine 의 W19 · W20 과 같은 전건 도달 증인이다)
#   W30 ← KW30 io_owner_frame = 32'h0 (W30 만)
#   W31 ← KW31 s3_valid <= s2_valid && !lat_hit (래치된 요청이 떠나는 에지에 다음 요청을 막는다 — W31 만)
#   W32 ← KW32 s3_valid <= s2_valid && !(첫 적중에 떠나는 요청) (W32 만)
#   W33 ← KW33 advance 에 「래치 ∧ 적중 ∧ 조회 프레임 ≠ 래치 프레임이면 기다린다」 항 (W33 만)
#   W34 ← KW34 XlateStore io_rsp_fromFill = 1'b0 (W34 만)
#   W35 ← KW35 XlateStore io_rsp_hostPresent = 1'b0 (W35 · W10 — W10 도 전건이 ¬f_lat 로 좁혀진 증인이다)
#   W36 ← MN1 정지 쪽 래치 삭제 (W36 만; HEAD 생성물에서도 W36 만 미도달)
#   W11 · W12 (전건이 ¬f_lat 로만 좁혀졌다) — 이 파도의 사살 변이는 없다 (시도 KW11 「저장 적중이 태그를 안 본다」는
#         채움 그림자 경로로 W11 이 여전히 도달해 무효). 반대로 MV1 · MS1 · MC1 · MC2 아래 cover 는 37/37 이다 —
#         증인이 결함에 매여 있지 않다 (2026-08-31 W10 · W12 교훈의 역대조).
#
# ### 동치 변이 — 어느 단언 · 시험도 못 잡는 것이 정상인 둘 (W2 독립 반증, 2026-10-12, 비상주)
#
# 독립 반증(44 변이 · hiumask bmc abc bmc3 d24 · prove abc pdr · Shape 스위트 — 생성 SV 의 module HiuPipeline
# 구간 치환, 저장소 밖 사본)에서 bmc 와 pdr 를 둘 다 통과한 변이는 둘이다. 둘 다 출력 동치 miter 로 *동치가
# 증명*됐다 — 좋은 사본 ∥ 변이 사본, XlateStore 는 두 사본이 공유하는 자유 스텁(hit ⇒ lookup.valid ·
# fromFill ⇒ hit), MaskUnit 왕복은 사본마다 advance 로 닫음, 초기값 setundef -zero -init, abc pdr. 감도
# 대조 M00 PASS · M01(래치 삭제) FAIL @5. 생존 변이로 계수하지 마라:
#   M13  latCapture 에서 s3_valid 항 탈락 — XlateStore 가 hit 을 이미 lookup.valid(= s3.valid)로 게이트한다
#        (생성 SV `storeHit = (((io_lookup_valid && storeValid) && …` · `fillHit = (((io_lookup_valid &&
#        fillShadow) && …`). 「포착은 유효 게이트된 적중에서만」의 실물 게이트는 XlateStore 의 그 두 항이고
#        latCapture 의 s3.valid 항은 관측상 중복이다(bmc PASS 299 초 · pdr PASS 95 초 · Shape 26/26 · miter
#        PASS). 그 축을 무는 단언은 l_capture_gated(유도 — 격리)와 형제 d_stall_src · q_miss_* 이고, 읽기
#        경로 전수의 정적 검사(HIU-3)는 아직 없다 — 이월.
#   M33  래치 비움 조건 advance → !io_hold — 래치가 선 사이클은 missWait = 0 이라 advance == !io_hold 이고,
#        래치가 빈 사이클의 비움은 무동작이다(bmc PASS 257 초 · pdr PASS 97 초 · miter PASS).
# 같은 실측의 M42(비움을 advance ∧ s2_valid 로 — 거품이 들어오는 에지에 안 비움)는 동치가 아니다: 전 단언
# bmc 는 q_miss_perm 이 거품 사이클의 래치 값으로 잡고(격리 l_clear 도 FAIL) cocotb 는 못 잡는다(거품의
# 데이터는 응답이 없다) — 유효 한정 miter 로는 동치다.

[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 24
bmc: aigsmt z3
prove: mode prove
prove: aigsmt z3
cover: mode cover
cover: depth 60

[engines]
bmc: abc bmc3
prove: abc pdr
cover: btor btormc

[script]
# ① 하네스를 「모듈 본문」과 「두 bind 문」으로 가른다
exec -- sh -c "sed /^bind/Q HiuMask_props.sv > props_only.sv"
exec -- sh -c "sed /^bind.HiuPipeline/Q HiuMask_props.sv > binds_head.sv"
exec -- sh -c "sed -n /^bind.MaskUnit/,+999p binds_head.sv | sed s/^bind.MaskUnit.// > mask_inst.sv"
exec -- sh -c "sed -n /^bind.HiuPipeline/,+999p HiuMask_props.sv | sed s/^bind.HiuPipeline.// > pipe_inst.sv"
# ② MaskUnit — 첫 endmodule 앞에 검사자 인스턴스를 주입
exec -- sh -c "sed /^endmodule/Q MaskUnit.sv > mask_dut.sv"
exec -- sh -c "sed -n /^endmodule/,+9999p MaskUnit.sv > mask_tail.sv"
exec -- sh -c "cat mask_inst.sv mask_tail.sv >> mask_dut.sv"
# ③ HiuPipeline — 같은 방식. 이 파일은 뒤에 XlateStore 를 더 담고 있으므로
#    파일 끝이 아니라 *첫* endmodule 앞이어야 한다 (위 함정 (1)).
exec -- sh -c "sed /^endmodule/Q HiuPipeline.sv > pipe_dut.sv"
exec -- sh -c "sed -n /^endmodule/,+9999p HiuPipeline.sv > pipe_tail.sv"
exec -- sh -c "cat pipe_inst.sv pipe_tail.sv >> pipe_dut.sv"
# 증인은 cover 태스크에서만 컴파일한다 — bmc/prove 모델은 단언만 든다.
bmc:   read_verilog -sv -formal props_only.sv
prove: read_verilog -sv -formal props_only.sv
cover: read_verilog -sv -formal -DHIUMASK_COVER props_only.sv
read_verilog -sv -formal mask_dut.sv
read_verilog -sv -formal pipe_dut.sv
prep -top HiuMask_comp

# [files] 경로는 저장소 루트 기준이다 — sby 는 상대 경로를 sby 파일이
# 아니라 *호출 cwd* 기준으로 푼다 (스윕 실측: ../ 경로가 루트 호출에서 깨짐).
# make rtl-postformal · 스윕 · 수동 실행 전부 루트에서 호출하는 것이 규약이다.
[files]
rtl/generated/MaskUnit.sv
rtl/generated/HiuPipeline.sv
rtl/sv/assert/HiuMask_props.sv
