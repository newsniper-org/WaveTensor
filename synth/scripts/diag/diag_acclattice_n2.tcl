#
# diag_acclattice_n2.tcl — GATE V20-2 재실측의 병기 요건 (spec §27.6 재실측
# 선언): 파라미터화 정합 확인용 N=2 구성 1회 synth-only (전 flow 불요).
#
# FP_AccLattice (beat-serial, PRODUCTS_PER_BEAT 파라미터) 를 N=2 로 합성해
# 기존 측정 전용 변형 FP_AccLatticeBeat2 의 실측 (xcu55c full-flow LUT
# 6,075) 과 비교한다. Beat2 는 serial resolve (9-cycle) + 별도 carry beat
# 구조이므로, 병렬 1-cycle 576-bit resolve 를 채택한 본 RTL 의 N=2 는
# +~1.1k LUT 급의 delta 가 기대된다 (576-bit carry-propagate 가산기의
# 병렬화 비용) — 동일 수치가 아니라 구조 차이를 설명하는 정합이 목적.
#
# 실행 (repo root 에서):
#   vivado -mode batch -nolog -nojournal \
#          -source synth/scripts/diag/diag_acclattice_n2.tcl
#
# 산출물: synth/reports/fp_ops/fp_acclattice_diag_n2_synth_util.rpt (+
# summary txt). gate 판정 대상 아님 — fp_op_gate_check.py 의 GATES 에
# 등재하지 않는다 (진단 전용).

set REPO_ROOT [file normalize [file join [file dirname [info script]] ../../..]]
set RPT_DIR   [file join $REPO_ROOT synth reports fp_ops]
file mkdir $RPT_DIR

set PART   "xcu55c-fsvh2892-2L-e"
set PERIOD 10.000
set TAG    "fp_acclattice_diag_n2"

create_project -in_memory -part $PART

read_verilog [file join $REPO_ROOT FP_AccLattice.v]
read_verilog [file join $REPO_ROOT synth lattice fp_ops FP_AccLattice_gate_top.v]

set xdc_file [file join $RPT_DIR ${TAG}_gate.xdc]
set fh [open $xdc_file w]
puts $fh "# generated by synth/scripts/diag/diag_acclattice_n2.tcl"
puts $fh "create_clock -name clk -period $PERIOD \[get_ports clk\]"
close $fh
read_xdc $xdc_file

synth_design -top FP_AccLattice_gate_top \
             -part $PART \
             -mode out_of_context \
             -include_dirs [file join $REPO_ROOT include] \
             -verilog_define WT_VENDOR_VIVADO=1 \
             -generic PRODUCTS_PER_BEAT=2 \
             -flatten_hierarchy none

report_utilization -file [file join $RPT_DIR ${TAG}_synth_util.rpt] \
                   -hierarchical

proc count_ref {pat} {
    return [llength [get_cells -quiet -hierarchical -filter "REF_NAME =~ {$pat}"]]
}

set n_lut  [count_ref "LUT?"]
set n_ff   [count_ref "FD*"]
set n_dsp  [count_ref "DSP48E*"]
set n_bram [expr {[count_ref "RAMB18*"] + [count_ref "RAMB36*"]}]

set fh [open [file join $RPT_DIR ${TAG}_summary.txt] w]
puts $fh "fp_acclattice_diag_n2 — FP_AccLattice PRODUCTS_PER_BEAT=2, synth-only"
puts $fh "part=$PART period=$PERIOD top=FP_AccLattice_gate_top"
puts $fh "lut_cells=$n_lut ff=$n_ff dsp48=$n_dsp bram=$n_bram"
puts $fh "(LUT SITES 는 ${TAG}_synth_util.rpt 의 Total LUTs 행 — Beat2 비교 기준)"
close $fh

puts ""
puts "================================================================"
puts "  $TAG synth-only summary ($PART)"
puts [format "  LUT cells = %d   FF = %d   DSP48 = %d   BRAM = %d" \
             $n_lut $n_ff $n_dsp $n_bram]
puts "================================================================"

exit 0
