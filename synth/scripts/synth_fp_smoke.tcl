# synth_fp_smoke.tcl — 신규 unit 의 SYNTH-ONLY smoke 측정 (gate 아님).
#
# synth_fp_op.tcl (out-of-context 전체 flow gate) 의 축약형: synth_design
# 까지만 수행하고 util/timing/summary 를 남긴다. gate 기준 없음 — 순수
# 측정. place/route 를 하지 않으므로 여기서 나오는 WNS 는 Fmax 가 아니다
# (본 프로젝트 실측: 같은 설계가 synth 후 WNS -1.835 ns, route 후 -0.205
# ns — cross_vendor_fabric_evidence.md §2). summary json 에 그 사실을
# 명기해 둔다.
#
# 용례 (repo root 에서; PART 는 반드시 명시):
#   vivado -mode batch -nolog -nojournal \
#          -source synth/scripts/synth_fp_smoke.tcl -tclargs \
#          TAG=fp_accbank TOP=FP_AccBank SRCS=FP_AccBank.v \
#          PART=xcu55c-fsvh2892-2L-e PERIOD=10.000
#
# -tclargs (NAME=value — synth_fp_op.tcl 규약 그대로):
#   TAG / TOP / SRCS(콤마 구분) / PART / PERIOD
#
# 리포트 (synth/reports/fp_ops/ — fp-op 관례 경로):
#   <TAG>_synth.xdc          생성된 clock-only OOC 제약 (자기서술 증적)
#   <TAG>_synth_util.rpt     synth 후 hierarchical utilization
#   <TAG>_synth_timing.rpt   synth 후 timing summary (Fmax 아님 — 위 주석)
#   <TAG>_synth_summary.json raw cell count (REF_NAME 기준) + synth WNS

foreach arg $argv {
    if {[regexp {^([A-Z_][A-Z_0-9]*)=(.*)$} $arg -> key val]} {
        set ::$key $val
    }
}

set REPO_ROOT [file normalize [file join [file dirname [info script]] ../..]]
set RPT_DIR   [file join $REPO_ROOT synth reports fp_ops]
file mkdir $RPT_DIR

foreach req {TAG TOP SRCS} {
    if {![info exists ::$req]} {
        puts "ERROR: missing required -tclargs $req=<value>"
        exit 1
    }
}
if {![info exists ::PART]}   { set ::PART "xcu55c-fsvh2892-2L-e" }
if {![info exists ::PERIOD]} { set ::PERIOD "10.000" }

puts ""
puts "================================================================"
puts "  synth-only smoke (측정, gate 아님): $::TAG"
puts "================================================================"
puts "  part      : $::PART"
puts "  top       : $::TOP"
puts "  period    : $::PERIOD ns  ([format %.2f [expr {1000.0/$::PERIOD}]] MHz)"
puts "  sources   : $::SRCS"
puts "  reports   : $RPT_DIR"
puts ""

create_project -in_memory -part $::PART

foreach src [split $::SRCS ","] {
    set p [file join $REPO_ROOT [string trim $src]]
    if {![file exists $p]} {
        puts "ERROR: source not found: $p"
        exit 1
    }
    read_verilog $p
}

set xdc_file [file join $RPT_DIR ${::TAG}_synth.xdc]
set fh [open $xdc_file w]
puts $fh "# generated by synth/scripts/synth_fp_smoke.tcl for smoke $::TAG"
puts $fh "# out-of-context, clock-only. synth-only smoke — 측정 전용."
puts $fh "create_clock -name clk -period $::PERIOD \[get_ports clk\]"
close $fh
read_xdc $xdc_file

synth_design -top $::TOP \
             -part $::PART \
             -mode out_of_context \
             -include_dirs [file join $REPO_ROOT include] \
             -verilog_define WT_VENDOR_VIVADO=1 \
             -flatten_hierarchy none

report_utilization    -file [file join $RPT_DIR ${::TAG}_synth_util.rpt] \
                      -hierarchical
report_timing_summary -file [file join $RPT_DIR ${::TAG}_synth_timing.rpt]

proc count_ref {pat} {
    return [llength [get_cells -quiet -hierarchical -filter "REF_NAME =~ {$pat}"]]
}

set n_lut   [count_ref "LUT?"]
set n_lutram [expr {[count_ref "RAM?32*"] + [count_ref "RAM?64*"] \
                    + [count_ref "RAM128*"] + [count_ref "RAM256*"] \
                    + [count_ref "RAM512*"]}]
set n_ff    [count_ref "FD*"]
set n_dsp   [count_ref "DSP48E*"]
set n_dspx  [count_ref "DSP_*"]
set n_carry [count_ref "CARRY*"]
set n_bram  [expr {[count_ref "RAMB18*"] + [count_ref "RAMB36*"]}]
set n_uram  [count_ref "URAM*"]
set n_srl   [count_ref "SRL*"]

set wns [get_property SLACK [get_timing_paths -delay_type max -max_paths 1]]

set js [file join $RPT_DIR ${::TAG}_synth_summary.json]
set fh [open $js w]
puts $fh "{"
puts $fh "  \"tag\": \"$::TAG\","
puts $fh "  \"top\": \"$::TOP\","
puts $fh "  \"part\": \"$::PART\","
puts $fh "  \"period_ns\": $::PERIOD,"
puts $fh "  \"flow\": \"synth_design ONLY — smoke 측정, gate 아님; wns 는 post-SYNTH (Fmax 아님)\","
puts $fh "  \"lut_cells\": $n_lut,"
puts $fh "  \"lutram_cells\": $n_lutram,"
puts $fh "  \"ff\": $n_ff,"
puts $fh "  \"dsp48\": $n_dsp,"
puts $fh "  \"dsp_split_cells\": $n_dspx,"
puts $fh "  \"carry\": $n_carry,"
puts $fh "  \"bram\": $n_bram,"
puts $fh "  \"uram\": $n_uram,"
puts $fh "  \"srl\": $n_srl,"
puts $fh "  \"synth_wns_ns\": $wns"
puts $fh "}"
close $fh

puts ""
puts "================================================================"
puts "  $::TAG synth-only smoke summary ($::PART)"
puts "================================================================"
puts [format "  LUT cells  = %d  (raw LUT1..LUT6; sites 는 _synth_util.rpt)" $n_lut]
puts [format "  LUTRAM     = %d  (RAM32/64/128/256/512 cells)" $n_lutram]
puts [format "  FF         = %d" $n_ff]
puts [format "  DSP48      = %d  (split DSP_* cells: %d)" $n_dsp $n_dspx]
puts [format "  CARRY      = %d" $n_carry]
puts [format "  BRAM       = %d   URAM = %d   SRL = %d" $n_bram $n_uram $n_srl]
puts [format "  synth WNS  = %.3f ns @ %s ns  (post-SYNTH — Fmax 아님)" \
             $wns $::PERIOD]
puts "  summary    -> $js"
puts ""

exit 0
