# generated by synth/scripts/synth_fp_op.tcl for gate sys_top_core
# out-of-context: no pin placement, clock definition only. The
# fp-ops cores are reset-free, so there is no reset false path
# unless RST_FALSE_PATH=1 was passed (GATE S1 system tops).
create_clock -name clk -period 10.000 [get_ports clk]
set_false_path -from [get_ports rst]
